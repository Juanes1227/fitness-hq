{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-hq",
  "compatibility_date": "2026-07-30",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-hq-db",
      // Reemplaza esto con el database_id real que te da:
      //   wrangler d1 create fitness-hq-db
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID"
    }
  ]
}
