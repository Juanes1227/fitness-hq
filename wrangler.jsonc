{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-hq",
  "compatibility_date": "2026-07-29",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Workers AI — no requiere API key, solo el binding. Incluido en el plan
  // gratuito (10.000 Neurons/día, compartidos entre todos los modelos).
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-hq-db",
      "database_id": "a5298030-e2a0-480f-ab29-c637938bb150"
    }
  ]
}
